/build
/captures
.externalNativeBuild
.cxx
benchmark-results/

app/build/
app/release/
wear/build/
wear/release/
shared/build/
baselineprofile/build/

# Editor / AI agent config (.vscode/, .agents/, .agent/, .claude/) is committed
# so it syncs across devices. Only machine-local agent settings stay ignored.
.claude/settings.local.json

